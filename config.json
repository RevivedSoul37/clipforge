{
  "transcription": {
    "model": "large-v3",
    "device": "auto",
    "compute_type": "auto",
    "language": "en",
    "initial_prompt": "Podcast conversation about fitness, discipline, consistency, business, money and self-improvement. Words used often: gym, workout, training, discipline, consistency, focus, habits, routine, success. Islamic expressions sometimes appear spelled normally: salam alaikum, Astaghfirullah, subhanallah, inshallah, alhamdulillah. The transcript uses proper capitalization and punctuation.",
    "condition_on_previous_text": false,
    "low_confidence_threshold": 0.55,
    "vad": {
      "enabled": true,
      "threshold": 0.5,
      "pad_in": 0.12,
      "pad_out": 0.18,
      "min_len": 12.0
    }
  },
  "llm": {
    "provider": "ollama",
    "model": "gemma4:12b",
    "base_url": "http://localhost:11434",
    "max_clips": 10,
    "min_score": 0.5,
    "chunk_words": 700,
    "chunk_overlap_words": 200,
    "num_ctx": 8192,
    "num_predict": 0,
    "think": false,
    "temperature": 0.2,
    "clean_transcript": true,
    "rules_file": "data/selection_rules.txt"
  },
  "context": {
    "target_platform": "youtube_shorts"
  },
  "cutting": {
    "lead_in_seconds": 0.3,
    "lead_out_seconds": 0.3,
    "max_raw_height": 1080,
    "encode": {
      "video_codec": "libx264",
      "audio_codec": "aac",
      "crf": 18,
      "preset": "veryfast"
    }
  },
  "default_template": "square_captioned",
  "vision": {
    "enabled": true,
    "model": "qwen2.5vl:7b",
    "base_url": "",
    "frames_per_variant": 2,
    "temperature": 0.1
  },
  "telegram": {
    "enabled": true
  },
  "explore": {
    "max_variants": 10,
    "preview_resolution": "540x960",
    "preview_crf": 28,
    "preview_preset": "ultrafast"
  },
  "paths": {
    "input": "input",
    "output": "output",
    "raw": "output/raw",
    "music": "music",
    "broll": "data/broll",
    "transcripts": "data/transcripts",
    "context": "data/context",
    "clip_candidates": "data/clip_candidates"
  }
}