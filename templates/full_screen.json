{
  "name": "full_screen",
  "golden": true,
  "label": "Full screen",
  "description": "9:16 fully covered by the video — no bars. Speaker-follow crop when face tracking is available, else center crop. Hook sits in the top safe zone, captions in the bottom safe zone, both kept away from the face and platform UI chrome.",
  "output": {
    "aspect_ratio": "9:16",
    "resolution": "1080x1920"
  },
  "crop": {
    "mode": "fill",
    "background": "#000000",
    "follow_speaker": true
  },
  "effects": {
    "grade": "none",
    "vignette": 0.0
  },
  "hook": {
    "enabled": true,
    "font": "Bebas Neue",
    "size": 84,
    "color": "#FFFFFF",
    "position": "top",
    "margin_v": 160
  },
  "captions": {
    "enabled": true,
    "font": "Poppins-Bold",
    "size": 72,
    "color": "#FFFFFF",
    "outline_color": "#000000",
    "outline_width": 4,
    "position": "bottom_center",
    "margin_v": 340,
    "max_words": 4,
    "gradient": {
      "enabled": false
    },
    "highlight_keyword": {
      "enabled": true,
      "color": "#F7E94A"
    }
  },
  "music": {
    "enabled": true,
    "track": "",
    "volume": 0.12
  },
  "broll": {
    "enabled": false,
    "mode": "cutaway",
    "pip_scale": 0.6
  },
  "intro": {
    "enabled": false
  },
  "outro": {
    "enabled": false
  },
  "watermark": {
    "enabled": false
  }
}
