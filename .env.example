# Copy this file to `.env` and edit values as needed.
# Everything here overrides the matching value in config.json.

# --- Transcription ---
# Whisper model size: tiny / base / small / medium / large-v2 / large-v3
WHISPER_MODEL=large-v3

# --- LLM (highlight selection, local via Ollama) ---
OLLAMA_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://localhost:11434

# --- Vision (style explorer auto-judge, local via Ollama) ---
# Pull it first:  ollama pull qwen2.5vl:7b  (or qwen2.5vl:3b on low VRAM)
# VISION_MODEL=qwen2.5vl:7b
# VISION_BASE_URL=http://localhost:11434

# --- Optional hosted API later (not used in v1) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- B-roll stock providers (optional; local library in data/broll/ works without them) ---
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# --- Transcript email (dedicated SMTP mailbox) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# TRANSCRIPT_RECIPIENT_EMAIL=
# TRANSCRIPT_FORWARD_EMAIL=

# --- Highlight source ---
# email (default) = email the transcript and ingest the AI highlight reply from
#   HIGHLIGHT_REPLY_SENDER via IMAP; clips arrive on the Approval page.
# local           = Ollama picks highlights inline.
# Campaigns can override this with the 'Local highlight selection' toggle in Settings.
# HIGHLIGHT_SOURCE=email
# HIGHLIGHT_REPLY_SENDER=syedmunavarahmed444@gmail.com
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_FOLDER=INBOX

# --- Telegram notifications ---
# 1. Create a bot: message @BotFather on Telegram -> /newbot -> copy the token here.
# 2. Send your bot any message (/start), then run:  python main.py telegram-setup
#    It lists recent chats with their chat id — copy yours into TELEGRAM_CHAT_ID.
# Group/channel ids are numeric and negative (e.g. -1001234567890); the bot
# must be a member. Master toggle lives in config.json -> telegram.enabled.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
